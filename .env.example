# Browser fallback (public client ID, not a secret)
VITE_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
VITE_DRIVE_FOLDER_NAME=LifeOS-Data
VITE_GEMINI_MODEL=gemini-2.5-flash

# Configure the personal Gemini key in app Settings.
# Do not put secrets in VITE_ variables for public deployments.

# Vercel server-only variables
APP_URL=https://your-app.vercel.app
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=replace-in-vercel
SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters
